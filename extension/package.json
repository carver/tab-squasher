{
  "name": "tab-squasher-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "lint": "npm run -s typecheck && eslint . && npm run -s build && web-ext lint --source-dir dist --warnings-as-errors",
    "test": "vitest run",
    "dev:desktop": "npm run -s build && ./scripts/web-ext-run.sh firefox-desktop",
    "dev:android": "npm run -s build && ./scripts/web-ext-run.sh firefox-android",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "sign": "./scripts/sign.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/node": "^22.20.4",
    "@types/selenium-webdriver": "^4.35.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "selenium-webdriver": "^4.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "web-ext": "^10.7.0"
  }
}
