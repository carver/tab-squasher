{
  "manifest_version": 3,
  "name": "tab-squasher",
  "version": "set by build.mjs from package.json",
  "description": "Save what a tab inspired as a Spark, then close the tab.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-squasher@carver",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/spark.svg",
    "96": "icons/spark.svg"
  },
  "action": {
    "default_title": "Spark this tab",
    "default_icon": "icons/spark.svg",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "alarms",
    "menus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
